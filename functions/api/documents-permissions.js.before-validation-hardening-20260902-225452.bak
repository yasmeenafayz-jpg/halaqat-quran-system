import {
  requireAuth,
  hasPermission,
  json
} from "../_auth.js";

export async function onRequest(context) {
  const { request, env } = context;

  const auth = await requireAuth(request, env);

  if (!auth.ok) {
    return auth.response;
  }

  const user = auth.user;

  if (request.method.toUpperCase() !== "POST") {
    return json({
      success: false,
      error: "METHOD_NOT_ALLOWED"
    }, 405);
  }

  if (
    !(await hasPermission(
      env.DB,
      user,
      "documents.permissions"
    ))
  ) {
    return json({
      success: false,
      error: "FORBIDDEN"
    }, 403);
  }

  let body;

  try {
    body = await request.json();
  } catch {
    return json({
      success: false,
      error: "INVALID_JSON"
    }, 400);
  }

  const documentId = Number(body.document_id);

  if (!Number.isInteger(documentId) || documentId <= 0) {
    return json({
      success: false,
      error: "INVALID_DOCUMENT_ID"
    }, 400);
  }

  const document = await env.DB
    .prepare(`
      SELECT id
      FROM documents
      WHERE id = ?
      LIMIT 1
    `)
    .bind(documentId)
    .first();

  if (!document) {
    return json({
      success: false,
      error: "DOCUMENT_NOT_FOUND"
    }, 404);
  }

  const permissions =
    Array.isArray(body.permissions)
      ? body.permissions
      : [];

  await env.DB
    .prepare(`
      DELETE FROM document_permissions
      WHERE document_id = ?
    `)
    .bind(documentId)
    .run();

  for (const item of permissions) {
    const role =
      item.role?.toString().trim() || null;

    const userId =
      item.user_id == null
        ? null
        : Number(item.user_id);

    if (
      userId !== null &&
      (!Number.isInteger(userId) || userId <= 0)
    ) {
      return json({
        success: false,
        error: "INVALID_USER_ID"
      }, 400);
    }

    if (!role && userId === null) {
      continue;
    }

    await env.DB
      .prepare(`
        INSERT INTO document_permissions (
          document_id,
          role,
          user_id,
          can_view,
          can_download,
          can_edit,
          can_delete,
          created_by
        )
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
      `)
      .bind(
        documentId,
        role,
        userId,
        item.can_view === false ? 0 : 1,
        item.can_download === false ? 0 : 1,
        item.can_edit === true ? 1 : 0,
        item.can_delete === true ? 1 : 0,
        user.id
      )
      .run();
  }

  return json({
    success: true,
    message: "DOCUMENT_PERMISSIONS_UPDATED"
  });
}
