{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "alawabin-schedule-cron",
  "main": "./index.js",
  "compatibility_date": "2026-08-19",

  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alawabin-db",
      "database_id": "214b2ef5-6937-43ab-a172-3f40f2c1bc63"
    }
  ],

  "vars": {
    "APP_NAME": "الأوَّابين",
    "APP_TIMEZONE": "Africa/Cairo"
  }
}
